NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://plate:plate_local@localhost:5433/plate?schema=public
# Generate a local secret with: openssl rand -hex 32
JWT_SECRET=
# Positive seconds or a duration with s, m, h, d; default is 1d.
JWT_EXPIRES_IN=1d
# Used only by npm run db:seed-admin. Do not commit real credentials.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# CORS_ORIGINS=https://example.com,https://app.example.com
